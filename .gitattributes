# Auto detect text files and perform LF normalization
* text=auto
# Store trained PyTorch checkpoints with Git LFS.
models/*.pt filter=lfs diff=lfs merge=lfs -text
models/kevin_20261011/*.pt filter=lfs diff=lfs merge=lfs -text
models/kevin_round2_20261011/*.pt filter=lfs diff=lfs merge=lfs -text
# Preserve frozen experiment and export checksums across Git checkouts.
docs/kevin_paper_20261011/** -text
training_logs/experiments/kevin_20261011/prepared/** -text
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
# Frozen review bundles and the fixture they pin: every file is checksummed, and the
# CSVs written by csv.DictWriter were sealed with CRLF line endings. Keep exact bytes.
docs/review_bundle/** -text
docs/review_bundle_v2/** -text
docs/validation_baseline_sources/** -text
tests/fixtures/external/** -text
